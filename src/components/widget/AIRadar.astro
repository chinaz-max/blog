---
import seed from "../../../public/data/ai-radar.json";
import { beijingTime, calendarDays, getSignal, record, sourceLink, type RadarSnapshot } from "../../utils/ai-radar";
import { normalizeTiboFeed, type TiboFeed } from "../../utils/tibo-feed";

const snapshot = seed as RadarSnapshot;
const signal = getSignal(snapshot);
const latest = record(record(record(snapshot.status?.payload).data).latest_reset);
const calendar = calendarDays(snapshot.history);
let posts: TiboFeed["posts"] = [];
try { posts = normalizeTiboFeed(snapshot.tibo?.payload).posts; } catch { /* Live data can recover. */ }
---

<aside class="radar-rail" aria-label="AI 动态">
    <ai-radar data-seed={JSON.stringify(snapshot)}>
        <details class="radar-shell">
            <summary class="radar-heading">
                <span class="radar-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8"/><path d="M12 4v8l5 5M8 12a4 4 0 0 0 4 4"/><circle cx="17.5" cy="6.5" r="2" class="radar-dot"/></svg></span>
                <span class="radar-heading-text"><strong>AI 动态</strong><small>Tibo · 中英动态</small></span>
                <span class="radar-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="radar-body">
                <div class="radar-section-label"><span>CODEX 重置观察</span><a href="https://x.com/thsottiaux" target="_blank" rel="noopener noreferrer">@Tibo ↗</a></div>
                <section class="radar-signal" data-kind={signal.kind} aria-label="下一次重置动态">
                    <span class="radar-status" data-field="signal-label">{signal.label}</span>
                    <h2 data-field="signal-title">{signal.title}</h2>
                    <p data-field="signal-description">{signal.description}</p>
                    <div class="radar-window" data-field="signal-window" hidden={!signal.until}>
                        <span data-field="window-label">{signal.kind === "prediction" ? "观察截止 · 非重置时间" : "预告参考时间 · 北京时间"}</span>
                        <strong data-field="window-time">{beijingTime(signal.until)}</strong>
                    </div>
                    <details class="radar-evidence" data-field="evidence" hidden={!signal.evidence}>
                        <summary>查看判断依据 <span aria-hidden="true">＋</span></summary>
                        <p data-field="evidence-text">{signal.evidence}</p>
                        <a data-field="evidence-link" href={signal.link || undefined} hidden={!signal.link} target="_blank" rel="noopener noreferrer">查看原始来源 ↗</a>
                    </details>
                </section>

                <div class="radar-latest">
                    <div><span>最近一次公告</span><strong data-field="latest-time">{beijingTime(latest.announced_at)}</strong></div>
                    <a data-field="latest-link" href={sourceLink(record(latest.source).url) || undefined} target="_blank" rel="noopener noreferrer">{latest.reset_type === "banked" ? "备用额度 ↗" : "常规重置 ↗"}</a>
                </div>

                <section class="radar-calendar" aria-label="近 28 天的重置公告记录">
                    <div class="radar-section-label"><span>近 28 天 · 公告记录</span><span>北京时间</span></div>
                    <div class="radar-days">{calendar.map(day => <a class="radar-day" data-type={day.type} href={day.link || undefined} title={`${day.date} · ${day.count ? `${day.count} 条公告` : "未收录公告"}`} aria-label={`${day.date} · ${day.count ? `${day.count} 条公告` : "未收录公告"}`} target="_blank" rel="noopener noreferrer"><span>{day.date.slice(8)}</span></a>)}</div>
                    <div class="radar-legend"><span><i data-type="regular"></i>常规</span><span><i data-type="banked"></i>备用</span><span><i data-type="none"></i>未收录</span></div>
                    <p class="radar-cache-note" data-field="history-note"></p>
                </section>

                <section class="radar-posts" aria-label="Tibo 最新动态" data-pagefind-ignore>
                    <div class="radar-section-label"><span>Tibo 最新动态</span><a href="https://x.com/thsottiaux" target="_blank" rel="noopener noreferrer">@thsottiaux ↗</a></div>
                    <div class="radar-post-toolbar">
                        <span>近期 5 条 · 含回复</span>
                        <div class="radar-languages" role="group" aria-label="帖子语言"><button type="button" data-language="zh" aria-pressed="true">中文</button><button type="button" data-language="en" aria-pressed="false">English</button></div>
                    </div>
                    <ol class="radar-post-list">{posts.map(post => <li class="radar-post" data-post-id={post.id}>
                        <div class="radar-post-meta"><time datetime={post.at}>{beijingTime(post.at)}</time><span>{post.is_reply ? "回复" : "帖子"}</span></div>
                        <p class="radar-post-text" lang={post.text_zh ? "zh-CN" : "en"}>{post.text_zh || post.text}</p>
                        <div class="radar-post-bottom"><span class="radar-post-translation">{post.text_zh ? "机器翻译" : "英文原文 · 中文待更新"}</span><a href={post.url} target="_blank" rel="noopener noreferrer">查看原帖 ↗</a></div>
                        <details class="radar-post-full" hidden={(post.text_zh || post.text).length <= 220}><summary>展开全文</summary><p class="radar-post-full-text" lang={post.text_zh ? "zh-CN" : "en"}>{post.text_zh || post.text}</p></details>
                    </li>)}</ol>
                    <template class="radar-post-template"><li class="radar-post">
                        <div class="radar-post-meta"><time></time><span></span></div>
                        <p class="radar-post-text"></p>
                        <div class="radar-post-bottom"><span class="radar-post-translation"></span><a target="_blank" rel="noopener noreferrer">查看原帖 ↗</a></div>
                        <details class="radar-post-full"><summary>展开全文</summary><p class="radar-post-full-text"></p></details>
                    </li></template>
                    <p class="radar-cache-note" data-field="posts-empty" hidden={posts.length > 0}>暂未获取帖子，可点击上方账号查看。</p>
                    <p class="radar-cache-note" data-field="posts-note">每 5 分钟检查 · 社区收录可能延迟或不完整</p>
                    <p class="radar-cache-note" data-field="posts-updated">{snapshot.tibo ? `帖子检查于 ${beijingTime(snapshot.tibo.fetchedAt, true)}` : "等待首次更新"}</p>
                    <p class="radar-cache-note" data-field="translation-note" role="status"></p>
                </section>

                <div class="radar-refresh-row"><span data-field="refresh-state" role="status">打开页面后自动检查</span><button type="button" class="radar-refresh" aria-label="刷新 AI 动态" title="刷新 AI 动态"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M20 10a8 8 0 1 0-1.4 6M20 4v6h-6"/></svg></button></div>
                <p class="radar-updated" data-field="updated">{snapshot.status ? `重置数据检查于 ${beijingTime(snapshot.status.fetchedAt, true)}` : "正在等待数据"}</p>
                <footer class="radar-footer">
                    <p>社区信息，不代表官方承诺或个人额度。</p>
                    <p>重置 <a href="https://codex-resets.com/" target="_blank" rel="noopener noreferrer">Codex Resets ↗</a> · 帖子 <a href="https://willreset.com/developers" target="_blank" rel="noopener noreferrer">Will Codex Reset ↗</a></p>
                    <p>翻译 <a href="https://mymemory.translated.net/" target="_blank" rel="noopener noreferrer">MyMemory ↗</a> · 以英文原文为准</p>
                    <p>灵感来自 <a href="https://codex-reset.top/" target="_blank" rel="noopener noreferrer">Tibo 重置助手 ↗</a></p>
                </footer>
            </div>
        </details>
    </ai-radar>
</aside>

<script>
    import { SOURCES, beijingTime, calendarDays, fresh, getSignal, normalizePayload, record, sourceLink, text, timestamp, type DatasetKey, type RadarSnapshot } from "../../utils/ai-radar";
    import { mergeTiboTranslations, translatePost, translationCost, type TiboFeed } from "../../utils/tibo-feed";

    const CACHE_KEY = "chuzun-ai-radar-v2";
    const LANGUAGE_KEY = "chuzun-tibo-language";
    const BUDGET_KEY = "chuzun-tibo-translation-budget";
    const POLL = 5 * 60_000;
    const keys = Object.keys(SOURCES) as DatasetKey[];

    class AIRadar extends HTMLElement {
        private snapshot: RadarSnapshot = { version: 1 };
        private life?: AbortController;
        private timer?: ReturnType<typeof setInterval>;
        private frame = 0;
        private busy = false;
        private lastAttempt = 0;
        private lastManual = 0;
        private failed = false;
        private language: "zh" | "en" = "zh";
        private translating = false;
        private translationRetryAt = 0;
        private translationNote = "";
        private translationBudget = { day: "", used: 0 };
        private postsFailed = false;

        connectedCallback() {
            this.life = new AbortController();
            this.frame = requestAnimationFrame(() => this.init());
        }

        disconnectedCallback() {
            cancelAnimationFrame(this.frame);
            clearInterval(this.timer);
            this.life?.abort();
            this.busy = false;
            this.translating = false;
        }

        private merge(value: unknown) {
            const incoming = record(value);
            if (incoming.version !== 1) return;
            for (const key of keys) {
                const data = record(incoming[key]);
                if (!Number.isFinite(timestamp(data.fetchedAt)) || timestamp(data.fetchedAt) > Date.now() + 60_000) continue;
                try {
                    let payload = normalizePayload(key, data.payload);
                    if (this.snapshot[key] && timestamp(this.snapshot[key]!.fetchedAt) >= timestamp(data.fetchedAt)) {
                        if (key === "tibo") this.snapshot[key]!.payload = mergeTiboTranslations(this.snapshot[key]!.payload as TiboFeed, payload as TiboFeed);
                        continue;
                    }
                    if (key === "tibo") payload = mergeTiboTranslations(payload as TiboFeed, this.snapshot.tibo?.payload as TiboFeed | undefined);
                    this.snapshot[key] = { fetchedAt: text(data.fetchedAt), payload };
                } catch { /* Skip an invalid cache entry. */ }
            }
        }

        private init() {
            try { this.merge(JSON.parse(this.dataset.seed || "{}")); } catch { /* The live fetch can recover. */ }
            try { this.merge(JSON.parse(localStorage.getItem(CACHE_KEY) || "{}")); } catch { /* Storage is optional. */ }
            try { this.language = localStorage.getItem(LANGUAGE_KEY) === "en" ? "en" : "zh"; } catch { /* Default to Chinese. */ }
            this.querySelectorAll<HTMLButtonElement>("[data-language]").forEach(button => button.addEventListener("click", () => {
                this.language = button.dataset.language === "en" ? "en" : "zh";
                try { localStorage.setItem(LANGUAGE_KEY, this.language); } catch { /* Storage is optional. */ }
                this.renderPosts();
                void this.translateMissing();
            }, { signal: this.life!.signal }));
            const media = matchMedia("(min-width: 1760px)");
            const setExpanded = () => { this.querySelector<HTMLDetailsElement>(".radar-shell")!.open = media.matches; };
            setExpanded();
            media.addEventListener("change", setExpanded, { signal: this.life!.signal });
            this.querySelector<HTMLButtonElement>(".radar-refresh")!.addEventListener("click", () => {
                if (this.busy || Date.now() - this.lastManual < 60_000) return;
                this.lastManual = Date.now();
                void this.refresh(true);
            }, { signal: this.life!.signal });
            document.addEventListener("visibilitychange", () => {
                if (!document.hidden && Date.now() - this.lastAttempt >= POLL) void this.refresh();
                if (!document.hidden) void this.translateMissing();
            }, { signal: this.life!.signal });
            this.render();
            void this.translateMissing();
            void this.refresh();
            this.timer = setInterval(() => {
                if (document.hidden) return;
                this.render();
                void this.translateMissing();
                if (Date.now() - this.lastAttempt >= POLL) void this.refresh();
            }, 60_000);
        }

        private field(name: string) { return this.querySelector<HTMLElement>(`[data-field="${name}"]`)!; }
        private write(name: string, value: string) {
            const field = this.field(name);
            if (field.textContent !== value) field.textContent = value;
        }
        private link(name: string, href: string | null) {
            const node = this.field(name);
            if (href) node.setAttribute("href", href); else node.removeAttribute("href");
            node.hidden = !href;
        }

        private async refresh(force = false) {
            if (this.busy || !this.life || this.life.signal.aborted || document.hidden) return;
            const now = Date.now();
            const due = keys.filter(key => force || !fresh(this.snapshot[key], now, POLL));
            this.lastAttempt = now;
            if (!due.length) return;
            this.busy = true;
            this.failed = false;
            this.render();
            const lifecycle = this.life.signal;
            const results = await Promise.allSettled(due.map(async key => {
                const response = await fetch(SOURCES[key], { signal: AbortSignal.any([lifecycle, AbortSignal.timeout(12_000)]), credentials: "omit", cache: "no-store" });
                if (!response.ok) throw new Error(`Source returned ${response.status}`);
                const payload = normalizePayload(key, await response.json());
                return { key, value: { fetchedAt: new Date().toISOString(), payload } };
            }));
            if (lifecycle.aborted) return;
            for (const [index, result] of results.entries()) {
                if (result.status === "fulfilled") {
                    const { key, value } = result.value;
                    if (key === "tibo") {
                        value.payload = mergeTiboTranslations(value.payload as TiboFeed, this.snapshot.tibo?.payload as TiboFeed | undefined);
                        this.postsFailed = false;
                    }
                    this.snapshot[key] = value;
                } else {
                    this.failed = true;
                    if (due[index] === "tibo") this.postsFailed = true;
                }
            }
            try { localStorage.setItem(CACHE_KEY, JSON.stringify(this.snapshot)); } catch { /* Live rendering does not require storage. */ }
            this.busy = false;
            this.render();
            void this.translateMissing();
        }

        private renderPosts() {
            const feed = this.snapshot.tibo?.payload as TiboFeed | undefined;
            const posts = feed?.posts || [];
            const list = this.querySelector<HTMLOListElement>(".radar-post-list")!;
            const template = this.querySelector<HTMLTemplateElement>(".radar-post-template")!;
            this.querySelectorAll<HTMLButtonElement>("[data-language]").forEach(button => button.setAttribute("aria-pressed", String(button.dataset.language === this.language)));
            for (const node of list.querySelectorAll<HTMLElement>("[data-post-id]")) if (!posts.some(post => post.id === node.dataset.postId)) node.remove();
            posts.forEach((post, index) => {
                let node = list.querySelector<HTMLElement>(`[data-post-id="${post.id}"]`);
                if (!node) {
                    node = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
                    node.dataset.postId = post.id;
                }
                if (list.children[index] !== node) list.insertBefore(node, list.children[index] || null);
                const translated = this.language === "zh" && Boolean(post.text_zh);
                const content = translated ? post.text_zh : post.text;
                const time = node.querySelector("time")!;
                time.dateTime = post.at;
                time.textContent = beijingTime(post.at);
                time.title = `北京时间 ${beijingTime(post.at, true)}`;
                node.querySelector(".radar-post-meta span")!.textContent = post.is_reply ? "回复" : "帖子";
                for (const paragraph of node.querySelectorAll<HTMLElement>(".radar-post-text, .radar-post-full-text")) {
                    if (paragraph.textContent !== content) paragraph.textContent = content;
                    paragraph.lang = translated ? "zh-CN" : "en";
                }
                node.querySelector(".radar-post-bottom a")!.setAttribute("href", post.url);
                node.querySelector(".radar-post-translation")!.textContent = translated ? (translationCost(post.text) ? "机器翻译" : "原帖内容") : this.language === "en" ? "英文原文" : "英文原文 · 中文待更新";
                node.querySelector<HTMLElement>(".radar-post-full")!.hidden = content.length <= 220;
            });
            this.field("posts-empty").hidden = posts.length > 0;
            this.write("posts-note", this.postsFailed ? "来源暂不可用 · 保留上次内容" : fresh(this.snapshot.tibo, Date.now()) ? "每 5 分钟检查 · 社区收录可能延迟或不完整" : "帖子缓存待刷新 · 社区收录可能延迟或不完整");
            this.write("posts-updated", this.snapshot.tibo ? `帖子检查于 ${beijingTime(this.snapshot.tibo.fetchedAt, true)}` : "等待首次更新");
            this.write("translation-note", this.language === "zh" ? this.translating ? "正在翻译新帖子…" : this.translationNote : "");
        }

        private async translateMissing() {
            if (this.translating || !this.life || this.life.signal.aborted || document.hidden || this.language !== "zh" || Date.now() < this.translationRetryAt) return;
            const posts = (this.snapshot.tibo?.payload as TiboFeed | undefined)?.posts.filter(post => !post.text_zh) || [];
            if (!posts.length) { this.translationNote = ""; this.renderPosts(); return; }
            const lifecycle = this.life.signal;
            this.translating = true;
            this.translationNote = "";
            this.renderPosts();
            try {
                for (const post of posts) {
                    if (document.hidden || this.language !== "zh") break;
                    lifecycle.throwIfAborted();
                    const day = new Date().toISOString().slice(0, 10);
                    try {
                        const saved = JSON.parse(localStorage.getItem(BUDGET_KEY) || "{}");
                        if (saved.day === day && Number.isFinite(saved.used) && saved.used >= 0) this.translationBudget = saved;
                    } catch { /* Keep the in-memory budget if storage is unavailable. */ }
                    if (this.translationBudget.day !== day) this.translationBudget = { day, used: 0 };
                    const cost = translationCost(post.text);
                    if (cost > 4500) {
                        this.translationNote = "部分长帖超出单日免费翻译额度，暂显示英文。";
                        continue;
                    }
                    if (this.translationBudget.used + cost > 4500) {
                        this.translationNote = "今日免费翻译额度已用完，未翻译内容显示英文。";
                        this.translationRetryAt = Date.parse(`${day}T00:00:00Z`) + 86_400_000;
                        break;
                    }
                    this.translationBudget.used += cost;
                    try { localStorage.setItem(BUDGET_KEY, JSON.stringify(this.translationBudget)); } catch { /* Never require storage. */ }
                    const translated = await translatePost(post.text, AbortSignal.any([lifecycle, AbortSignal.timeout(40_000)]));
                    if (lifecycle.aborted) return;
                    const current = (this.snapshot.tibo?.payload as TiboFeed | undefined)?.posts.find(item => item.id === post.id && item.text === post.text);
                    if (current) current.text_zh = translated;
                    try { localStorage.setItem(CACHE_KEY, JSON.stringify(this.snapshot)); } catch { /* Keep the in-memory translation. */ }
                    this.renderPosts();
                }
            } catch {
                if (lifecycle.aborted) return;
                this.translationNote = "免费翻译暂不可用，保留英文原文，稍后自动重试。";
                this.translationRetryAt = Date.now() + 30 * 60_000;
            } finally {
                if (!lifecycle.aborted) { this.translating = false; this.renderPosts(); }
            }
        }

        private render() {
            const now = Date.now();
            const signal = getSignal(this.snapshot, now);
            this.querySelector<HTMLElement>(".radar-signal")!.dataset.kind = signal.kind;
            this.write("signal-label", signal.label);
            this.write("signal-title", signal.title);
            this.write("signal-description", signal.description);
            this.field("signal-window").hidden = !signal.until;
            this.write("window-label", signal.kind === "prediction" ? "观察截止 · 非重置时间" : "预告参考时间 · 北京时间");
            this.write("window-time", beijingTime(signal.until));
            this.field("evidence").hidden = !signal.evidence;
            this.write("evidence-text", signal.evidence);
            this.link("evidence-link", signal.link);
            const latest = record(record(record(this.snapshot.status?.payload).data).latest_reset);
            this.write("latest-time", beijingTime(latest.announced_at));
            this.write("latest-link", latest.reset_type === "banked" ? "备用额度 ↗" : "常规重置 ↗");
            this.link("latest-link", sourceLink(record(latest.source).url));
            const cells = this.querySelectorAll<HTMLAnchorElement>(".radar-day");
            calendarDays(this.snapshot.history, now).forEach((day, index) => {
                const cell = cells[index];
                cell.dataset.type = day.type;
                const kind = day.type === "both" ? "常规与备用" : day.type === "banked" ? "备用" : "常规";
                cell.title = `${day.date} · ${day.count ? `${day.count} 条${kind}公告` : "未收录公告"}`;
                cell.setAttribute("aria-label", cell.title);
                cell.querySelector("span")!.textContent = day.date.slice(8);
                if (day.link) cell.href = day.link; else cell.removeAttribute("href");
            });
            this.write("history-note", fresh(this.snapshot.history, now) ? "" : this.snapshot.history ? `历史缓存 · ${beijingTime(this.snapshot.history.fetchedAt, true)}` : "历史记录暂不可用");
            this.renderPosts();
            const current = fresh(this.snapshot.status, now);
            this.write("refresh-state", this.busy ? "正在检查动态…" : this.failed ? "部分来源暂不可用 · 稍后重试" : current ? "每 5 分钟自动检查" : "显示历史缓存 · 等待更新");
            this.field("refresh-state").dataset.fresh = String(current && !this.failed);
            this.write("updated", this.snapshot.status ? `重置数据检查于 ${beijingTime(this.snapshot.status.fetchedAt, true)}` : "尚未获取重置数据");
            const button = this.querySelector<HTMLButtonElement>(".radar-refresh")!;
            button.disabled = this.busy || now - this.lastManual < 60_000;
            button.classList.toggle("is-loading", this.busy);
        }
    }
    if (!customElements.get("ai-radar")) customElements.define("ai-radar", AIRadar);
</script>

<style>
    .radar-rail { margin-bottom: 1rem; min-width: 0; }
    ai-radar { display: block; color: #50535b; font-size: 12px; line-height: 1.6; }
    .radar-shell { background: var(--card-bg); border: 1px solid var(--line-divider); border-radius: var(--radius-large); overflow: hidden; }
    .radar-heading { display: flex; gap: 10px; align-items: center; padding: 16px; cursor: pointer; list-style: none; }
    .radar-heading::-webkit-details-marker { display: none; }
    .radar-mark { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 11px; background: var(--btn-regular-bg); color: var(--btn-content); }
    .radar-mark svg { width: 25px; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .radar-mark .radar-dot { fill: var(--btn-content); stroke: var(--card-bg); }
    .radar-heading-text { display: flex; flex: 1; align-items: baseline; gap: 12px; }
    .radar-heading strong { color: #292c34; font-size: 17px; letter-spacing: .025em; }
    .radar-heading small { color: #888c95; font-size: 11px; }
    .radar-chevron { color: #9297a1; font-size: 21px; transition: transform .2s; }
    .radar-shell[open] > .radar-heading .radar-chevron { transform: rotate(180deg); }
    .radar-body { padding: 0 16px 16px; }
    .radar-section-label { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: #898d96; font-size: 10px; letter-spacing: .04em; margin-bottom: 9px; }
    .radar-section-label > span:first-child { color: #686d77; font-weight: 600; }
    .radar-section-label a { color: var(--btn-content); }
    .radar-signal { padding: 13px; background: var(--btn-regular-bg); border-radius: 11px; }
